# Primary AI provider (GPT-6 Astra)
# Server-only. Never expose this key to the browser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
OPENAI_REASONING_EFFORT=high

# Existing Groq fallback provider
GROQ_API_KEY=

# Server-only Vercel deployment configuration
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
# Optional when deploying to a Vercel team
VERCEL_TEAM_ID=
