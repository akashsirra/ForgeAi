# Primary AI provider (GPT-6 Astra)
# Server-only. Never expose this key to the browser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
OPENAI_REASONING_EFFORT=high

# Existing Groq fallback provider
GROQ_API_KEY=

# Server-only Vercel deployment configuration
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
# Optional when deploying to a Vercel team
VERCEL_TEAM_ID=

# Production billing (Stripe)
# Create a recurring Stripe Price for ForgeAI Pro and paste its price ID here.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Public app URL used for Stripe redirects.
NEXT_PUBLIC_APP_URL=https://your-forgeai-domain.example
NEXT_PUBLIC_PRO_PRICE_LABEL=₹499 / month
